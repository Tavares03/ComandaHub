# Copie para backend/.env para rodar a API direto na maquina (sem Docker).
# Variaveis de ambiente do terminal tem prioridade sobre este arquivo.

ENVIRONMENT=development

# PostgreSQL local (o banco e criado sozinho na subida via Docker; sem Docker, crie com: createdb comandahub)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/comandahub
# Sem PostgreSQL: SQLite em arquivo
# DATABASE_URL=sqlite+pysqlite:///./comandahub.db

# Chave para assinar os tokens de login (32+ caracteres; obrigatoria e forte em producao)
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-32-chars

BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
LOG_LEVEL=INFO
