# Copie para .env na raiz (o docker compose le este arquivo sozinho).

# ---------------------------------------------------------------- desenvolvimento
# docker-compose.yml: PostgreSQL da sua maquina na porta 5432 (o banco "comandahub" e criado sozinho).
# Usando o Postgres incluso (docker compose --profile db up) o endereco e o mesmo.
DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5432/comandahub
# Carrega lojas, cardapios, usuarios e pedidos de exemplo a cada subida (idempotente)
SEED_DEMO_DATA=true

# ---------------------------------------------------------------- producao (docker-compose.prod.yml)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-de-32-chars
# Senha do PostgreSQL de producao (use letras e numeros)
POSTGRES_PASSWORD=
# Porta publica do painel (nginx)
HTTP_PORT=80
